# GEMINI_API_KEY: Required for server-side Gemini AI calls (/api/ai/*).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL where this application is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Mandatory persistent secret for HMAC session tokens and encrypted integration secrets.
# Generate locally with: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_64_HEX_CHAR_SECRET"

# First-Time Single Main Admin Provisioning (used only when no Admin user exists yet)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Main Admin"
ADMIN_PHONE=""

# Persistent Relational Database
# Primary local relational store defaults to data/edupro.db (SQLite WAL + FKs).
# Set DATABASE_URL to connect PostgreSQL (run db/migrations/001_initial_postgres.sql).
DATABASE_URL=""
PGSSL="false"

# Payment Gateway Webhooks & Credentials (or configure via Main Admin -> Integrations & 2FA)
PAYMENT_WEBHOOK_SECRET=""

# Outbound Email (SMTP via Nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Bangladesh SMS Gateway (BulkSMSBD)
BULKSMSBD_API_KEY=""
BULKSMSBD_SENDER_ID=""

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
